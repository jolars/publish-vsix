    "verify": "versionary verify",
    "check": "npm run format:check && npm run lint && npm test && npm run verify"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@vscode/vsce": "4.0.0",
    "ovsx": "1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.0",
    "versionary": "1.4.0"
  }
}
