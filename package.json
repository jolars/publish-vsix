{
  "name": "publish-vsix",
  "private": true,
  "description": "Publish VSIX packages to Visual Studio Marketplace and Open VSX with retries",
  "type": "module",
  "license": "BSD-3-Clause",
  "author": "Johan Larsson",
  "repository": {
    "type": "git",
    "url": "https://github.com/jolars/publish-vsix.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "lint": "eslint .",
    "format": "prettier --write .",
